# Copy to .env.local (git-ignored) and fill in. Loaded ONLY by ./run-local.sh, never by tests.
export EMBEDDING_API_KEY=PUT_YOUR_JINA_API_KEY_HERE

# Optional overrides (these are already the defaults):
# export EMBEDDING_PROVIDER=jina
# export EMBEDDING_MODEL=jina-embeddings-v4
# export EMBEDDING_API_URL=https://api.jina.ai/v1/embeddings
# export EMBEDDING_DIMENSION=2048

# Search tuning - decide by experimentation (see ../PLACEHOLDERS_TO_CHANGE.md):
# export SEARCH_SEMANTIC_WEIGHT=0.7
# export SEARCH_HYBRID_THRESHOLD=0.3
# export SEARCH_SEMANTIC_THRESHOLD=0.3
# export SEARCH_LEXICAL_THRESHOLD=0.2

# Testing convenience (D23): each browser tab can be a different account. On in `./run-local.sh dev`; set false to switch it off.
# export PER_TAB_SESSIONS=false

# One-off: embed existing questions that have no vector yet, then switch back off.
# export EMBEDDING_REINDEX_ON_STARTUP=true

# Google sign-in (when you have credentials):
# export GOOGLE_CLIENT_ID=...
# export GOOGLE_CLIENT_SECRET=...
