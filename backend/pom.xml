<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.fixit</groupId>
    <artifactId>fix-it-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>fix-it-backend</name>
    <description>Fix It backend</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- pgvector Java support (vector type for JDBC / Hibernate) -->
        <dependency>
            <groupId>com.pgvector</groupId>
            <artifactId>pgvector</artifactId>
            <version>0.1.6</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The website: ../frontend is packaged into the app as static files (served at /, /login.html, /css/..., /js/...) -->
            <resource>
                <directory>../frontend</directory>
                <targetPath>static</targetPath>
                <!-- only the website itself is packaged, never the tests or tooling -->
                <excludes>
                    <exclude>test/**</exclude>
                    <exclude>node_modules/**</exclude>
                    <exclude>package.json</exclude>
                    <exclude>package-lock.json</exclude>
                    <exclude>test-results/**</exclude>
                    <exclude>playwright-report/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <!-- Tests run against placeholders/fakes and must never call the real embedding API, even if
                             a real key is exported in the developer's shell. (Live tests use JINA_LIVE_KEY instead.) -->
                        <EMBEDDING_API_KEY></EMBEDDING_API_KEY>
                        <!-- Every distinct test configuration is a cached Spring context with its own DB pool (default 10).
                             With ~15 contexts that exceeds PostgreSQL's 100 connections ("too many clients already"),
                             so tests use small pools. Production keeps the normal pool size. -->
                        <SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE>4</SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE>
                        <SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE>1</SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
